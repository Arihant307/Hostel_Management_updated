# ---------------------------------------------------------------------------
# Backend configuration — copy to backend/.env and fill in real values.
# NEVER commit the real .env file. Placeholders only below.
# ---------------------------------------------------------------------------

# development | production | testing
FLASK_ENV=development
FLASK_APP=run.py

# Long random strings. Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string

# Access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# SQLAlchemy database URL. Relative SQLite paths are resolved inside backend/instance/.
DATABASE_URL=sqlite:///hostel.db

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public address of the React app. Used to build the links inside emails
# (verify email, reset password, staff invitations).
FRONTEND_URL=http://localhost:5173

# Name shown in emails and on receipts
HOSTEL_NAME=HostelHub Residence

# ---------------------------------------------------------------------------
# Account policy
# ---------------------------------------------------------------------------
# Allow students to register themselves on the Sign up page.
STUDENT_SIGNUP_ENABLED=true
# After verifying their email, self-registered students wait for a warden/admin
# to approve them before they can sign in.
STUDENT_APPROVAL_REQUIRED=true
# Allow staff to apply without an invitation (an admin must approve them).
# Set to false to accept staff ONLY through admin-issued invitation codes.
STAFF_SIGNUP_ENABLED=true
# Self-registered accounts must confirm their email before signing in.
EMAIL_VERIFICATION_REQUIRED=true
# Link lifetimes
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
STAFF_INVITATION_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# file : DEVELOPMENT ONLY. Emails are not sent; each one is written as a .txt
#        file to backend/instance/dev-outbox/ so you can open the links.
# smtp : real delivery through the SMTP server below.
# brevo: real delivery through Brevo's free HTTPS API (300 emails/day). Use this
#        on Render's free plan, which blocks outgoing SMTP ports.
# Production accepts smtp or brevo only.
MAIL_BACKEND=file

# SMTP settings (used when MAIL_BACKEND=smtp). Examples:
#   Gmail:    MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=true
#             (use a Google "App password", not your normal password)
#   Outlook:  MAIL_SERVER=smtp.office365.com  MAIL_PORT=587  MAIL_USE_TLS=true
#   Brevo/SendGrid/Mailgun: use the SMTP host, port and credentials they give you.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
# The From address, e.g.  HostelHub <no-reply@your-college.edu>
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT_SECONDS=15

# Brevo settings (used when MAIL_BACKEND=brevo). Brevo -> SMTP & API -> API Keys.
# MAIL_DEFAULT_SENDER above must be a sender verified in Brevo.
BREVO_API_KEY=

# ---------------------------------------------------------------------------
# Deployment (Render)
# ---------------------------------------------------------------------------
# Header carrying the visitor's real IP behind a proxy. Render: True-Client-IP.
# Leave empty locally.
CLIENT_IP_HEADER=

# First administrator, created by `flask ensure-admin` (run at every start on
# Render) if it does not exist yet. Password: 10+ chars, upper, lower, digit.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Production refuses SQLite (files are erased on a free Render restart).
# Set to true only for a throw-away demo.
# ALLOW_SQLITE_IN_PRODUCTION=false

# Optional: run the test suite against PostgreSQL instead of in-memory SQLite.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/hms_test

# ---------------------------------------------------------------------------
# Frontend configuration — put this ONE line in frontend/.env
# (Vite only exposes variables that start with VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:5000/api
